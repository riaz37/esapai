# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE/editor
/.cursor/
.cursor/rules/
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
.agent/
.shared/

# large original assets
public/*_orig.mp4
public/members-videos/*.mov
public/videos/originals/
public/productvideos/originals/
public/product-videos/originals/
public/services/originals/
/.studio

.gstack/

# graphify knowledge graph outputs
/graphify-out/
